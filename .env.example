NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=KJIN
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
KJIN_OWNER_EMAIL=
KJIN_OWNER_NAME=

# ==============================================================================
# Security & Media Controls
# ==============================================================================
# ALLOW_LOOPBACK_IMAGES: Set to 'true' ONLY in local development or test environments
# to permit loopback image URLs (localhost, 127.0.0.1). Permanently blocked in production.
# ALLOW_LOOPBACK_IMAGES=false

# ALLOWED_IMAGE_HOSTS: Comma-separated list of additional exact HTTPS image hostnames
# or validated https:// URLs permitted by the rich-text HTML sanitizer (e.g., cdn.custom-news.com, https://media.partner.org).
# Insecure schemes (http://, ftp://), loopback hosts in production, and wildcards are strictly rejected.
# ALLOWED_IMAGE_HOSTS=

# ALLOWED_STAGING_PROJECT_IDS: Comma-separated list of staging/isolated Supabase project
# references authorized for integration tests and preview staging environments.
# Production database (ptvfidufwlswbjgsjvzl) is permanently blocked by test guards.
# ALLOWED_STAGING_PROJECT_IDS=

# ==============================================================================
# SMTP Email Delivery (Nodemailer)
# ==============================================================================
# SMTP credentials used to send employee invitation emails with initial credentials.
# For Gmail: Use an App Password (16 characters from Google Account -> Security -> App Passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KJIN Newsroom" <noreply@kjin.local>

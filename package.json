{
  "name": "kjin",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter @kjin/web --filter @kjin/admin dev",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:admin": "pnpm --dir apps/admin dev",
    "build:web": "pnpm --dir apps/web build",
    "build:admin": "pnpm --dir apps/admin build",
    "lint": "pnpm -r lint",
    "worker:youtube": "pnpm --filter @kjin/admin run worker:youtube",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "rss-parser": "^3.13.0"
  }
}

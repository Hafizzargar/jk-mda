{
  "name": "kjin",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:admin": "pnpm --dir apps/admin dev",
    "build:web": "pnpm --dir apps/web build",
    "build:admin": "pnpm --dir apps/admin build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/node": "^24.0.0"
  }
}
